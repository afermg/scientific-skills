{
  inputs = {
    # Default to unstable; fall back to nixos-24.11 if the dep solve is hostile.
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    systems.url = "github:nix-systems/default";
    flake-utils.url = "github:numtide/flake-utils";
    flake-utils.inputs.systems.follows = "systems";
    # Pull nahual + pynng straight from their flakes — no nix/nahual.nix or
    # nix/pynng.nix vendored locally. follows = "nixpkgs" is LOAD-BEARING:
    # without it, nahual builds against its own pinned python interpreter
    # and python.withPackages silently drops it from a wrap that uses a
    # different python ABI.
    nahual-flake.url = "github:afermg/nahual";
    nahual-flake.inputs.nixpkgs.follows = "nixpkgs";
    pynng-flake.url = "github:afermg/pynng";
    pynng-flake.inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs =
    {
      self,
      nixpkgs,
      flake-utils,
      systems,
      ...
    }@inputs:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        pkgs = import nixpkgs {
          system = system;
          config = {
            allowUnfree = true;
            # GPU is required. Don't set this to false to dodge a slow build.
            cudaSupport = true;
          };
        };
      in
      with pkgs;
      rec {
        apps.default =
          let
            python_with_pkgs = python3.withPackages (pp: [
              inputs.nahual-flake.packages.${system}.nahual
              pp.torch
              pp.torchvision
              pp.numpy
              pp.pillow
              # Add ONLY runtime deps server.py imports. Don't add `timm`
              # speculatively — it can trigger a 30+ min test rebuild on
              # unstable.
            ]);
            runServer = pkgs.writeScriptBin "runserver.sh" ''
              #!${pkgs.bash}/bin/bash
              # PYTHONSAFEPATH=1 (Python 3.11+) prevents Python from
              # prepending the script's directory to sys.path. This stops
              # the in-tree `<MODEL>/` source dir at ${self} from shadowing
              # the nix-built compiled package — same source-shadow trap
              # that `from server import setup` would otherwise hit when
              # basic_test.py runs.
              export PYTHONSAFEPATH=1
              ${python_with_pkgs}/bin/python ${self}/server.py ''${@:-"ipc:///tmp/<MODEL>.ipc"}
            '';
          in
          {
            type = "app";
            program = "${runServer}/bin/runserver.sh";
          };

        devShells = {
          default =
            let
              python_with_pkgs = python3.withPackages (pp: [
                inputs.nahual-flake.packages.${system}.nahual
                pp.torch
                pp.torchvision
                pp.numpy
                pp.pillow
                # Dev-only extras
                pp.tifffile
                pp.scikit-image
                pp.scikit-learn
                pp.pyyaml
              ]);
            in
            mkShell {
              packages = [
                python_with_pkgs
                pkgs.cudaPackages.cudatoolkit
                # Some PyTorch wraps also want cudnn explicitly:
                # pkgs.cudaPackages.cudnn
              ];
              # Don't `export PYTHONPATH=…sitePackages` — `python.withPackages`
              # already wraps the python binary with its site-packages on the
              # import path. The redundant export was masking source-shadow
              # bugs in older wraps; PYTHONSAFEPATH=1 is the correct fix.
              shellHook = ''
                export PYTHONSAFEPATH=1
              '';
            };
        };
      }
    );
}
